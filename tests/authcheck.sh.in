#!/bin/sh
# Check that Maxima proves to xmaxima that it is the Maxima xmaxima started,
# and that xmaxima refuses whoever else connects first.
# Usage: authcheck.sh <lisp>
# Exit 77 (Automake SKIP) without a tclsh.
set -eu

if test "$#" -ne 1; then
    echo "Usage: $0 <lisp>" >&2
    exit 2
fi

LOCAL_MAXIMA=${MAXIMA:-@abs_top_builddir@/maxima-local}
TCLSH=${TCLSH:-tclsh}
if ! command -v "$TCLSH" >/dev/null 2>&1; then
    echo "authcheck: SKIP (no tclsh)"
    exit 77
fi

exec "$TCLSH" '@abs_top_srcdir@/tests/authcheck.tcl' "$LOCAL_MAXIMA" \
    "$1" '@abs_top_srcdir@/interfaces/xmaxima/Tkmaxima'

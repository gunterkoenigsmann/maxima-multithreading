/* Against a reference that does not eliminate at all: Cramer's rule with
   the default determinant, which expands by minors (TREEDET) and never
   reaches TFGELI.  Each item also checks the eliminating determinant
   against it, the inverse by multiplying back, and the rank.  It returns
   its index on any disagreement, so a failure names the item. */
(cramer_check(i) :=
   block([a: m(i), b: [i, 1, i^2, 2], d, sol],
     d: determinant(a),
     sol: linsolve(makelist(sum(a[r, c]*v[c], c, 1, 4) = b[r], r, 1, 4),
                   makelist(v[c], c, 1, 4)),
     if is(map(rhs, sol)
           = makelist(determinant(genmatrix(lambda([r, c],
                                                   if c = k then b[r]
                                                   else a[r, c]),
                                            4, 4))/d,
                      k, 1, 4))
        and is(block([ratmx: true], determinant(a)) = d)
        and is(ratsimp(a . invert_by_gausselim(a)) = ident(4))
        and is(rank(a) = 4)
     then 0 else i),
 sublist(makelist(cramer_check(i), i, 1, 24), lambda([k], k # 0)));

[]$

sublist(parallel_makelist(cramer_check(i), i, 1, 24), lambda([k], k # 0));

[]$

(kill(all),0);


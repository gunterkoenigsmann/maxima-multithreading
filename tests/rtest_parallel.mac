 [echelon(matrix([1, 2], [3, 4])), triangularize(matrix([1, 2], [3, 4])),
  same_scratch(s0, elimination_scratch())]);

[matrix([1, 2], [0, 1]), matrix([1, 2], [0, -2]), true]$

(s0: elimination_scratch(),
 [invert_by_gausselim(matrix([2, 1], [1, 1])),
  same_scratch(s0, elimination_scratch())]);

[matrix([1, -1], [-1, 2]), true]$

/* This integrand reaches LSA through RISCHEXPVAR. */
(s0: elimination_scratch(),
 risch(%e^(2*cos(x))*cos(2*sin(x)), x),
 same_scratch(s0, elimination_scratch()));

true$

/* The same operations in parallel, against the serial answers.  The
   systems have unique solutions, so no %r parameters take part.  The
   sleep makes sure the workers take items at all.  risch() is left out:
   concurrent calls still lose closed forms for another reason (GitHub
   issue #63). */
(m(i) := matrix([i, 2, 3, 1], [4, i + 1, 6, 2], [7, 8, i + 2, 3],
                [1, 0, 2, i]),
 elimination_ops(i) :=
   (?sleep(0.005),
    [solve([x + y + z = i, x - y = 1, x + z = i^2], [x, y, z]),
     linsolve([x + 2*y = i, 3*x - y = 1], [x, y]),
     block([ratmx: true], determinant(m(i))),
     rank(m(i)), echelon(m(i)), triangularize(m(i)),
     invert_by_gausselim(m(i))]),
 0);

0$


/* Tests for parallel_makelist.

   Two things are being asserted here, and they need different kinds of
   test.  That the answers are right is ordinary: compare against
   makelist, which computes the same thing serially.  That the work
   actually happened on more than one thread is not, because a parallel
   run that quietly fell back to the serial path returns exactly the
   right answers and would pass every comparison in this file.

   So the comparisons are paired with parallel_worker_items(), which
   counts elements evaluated by a worker thread and which the serial
   path cannot make nonzero.  Those tests assert the count is positive
   where threads exist and zero where they do not, so they can fail in
   either direction rather than only in one. */

(kill(all), 0);
0$

/* --- the same answers as makelist, in every argument shape --- */

is(parallel_makelist() = makelist());
true$

is(parallel_makelist(5, 3) = makelist(5, 3));
true$

is(parallel_makelist(i^2, i, 1, 10) = makelist(i^2, i, 1, 10));
true$

is(parallel_makelist(x, x, [a, b, c]) = makelist(x, x, [a, b, c]));
true$

is(parallel_makelist(i, i, 2, 8) = makelist(i, i, 2, 8));
true$

is(parallel_makelist(i, i, 2, 8, 3) = makelist(i, i, 2, 8, 3));
true$

/* An empty range is empty, not a one-element list */

is(parallel_makelist(i, i, 1, 0) = makelist(i, i, 1, 0));
true$

/* --- symbolic work, where the two could plausibly disagree ---

   Rational arithmetic is the interesting case: workers renumber CRE
   variables, so if per-thread isolation of varlist/genvar/vlist were
   incomplete these would come back wrong rather than merely slow. */

is(parallel_makelist(ratsimp((x^i - 1)/(x - 1)), i, 1, 12)
   = makelist(ratsimp((x^i - 1)/(x - 1)), i, 1, 12));
true$

/* rat(), unlike ratsimp(), converts with the GENVAR list it finds, and
   renumbers its symbols' value cells, which rank the variables.  So a
   worker must start with a list of its own rather than share the
   caller's symbols: shared, one runner's ranks were rewritten by another
   midway and results mixed up variables between elements -- x turned up
   in the quotient in a, b, c and d, 44 (SBCL) and 15 (CCL) times in 480
   (GitHub issue #80).  The serial reference leaves genvars in the
   caller's list; the comparison comes in the next input, which starts
   with an empty VARLIST, as every input does, so that each element
   ranks only its own variables. */

(rat_mix(i) := if oddp(i) then ratdisrep(rat((x + i)^4/(x - 1)))
               else ratdisrep(rat((a + b + c + d + i)^3/(a - b))),
 rat_mix_ref: makelist(rat_mix(i), i, 1, 48),
 0);
0$

(parallel_reset_counters(),
 [length(sublist(makelist(is(parallel_makelist(rat_mix(i), i, 1, 48)
                             = rat_mix_ref), rep, 1, 10),
                 lambda([same], not same))),
  if parallel_threads_available()
      then is(parallel_worker_items() > 0)
      else is(parallel_worker_items() = 0)]);
[0, true]$

/* solve() exercises the %r numbering in $%RNUM_LIST, which is bound per
   thread and would otherwise make results depend on completion order */

is(parallel_makelist(solve(x^2 - i, x), i, 1, 8)
   = makelist(solve(x^2 - i, x), i, 1, 8));
true$

/* integrate() is the interesting one: it works inside a scratch context
   made by with_new_context(), so before each runner had its own context
   variables two workers would lose one of the two names out of the one
   shared list and the loser failed with "supcontext: no such context
   ctxt<n>".  Every one of 30 runs failed that way, and a scratch
   context was left behind in the user-visible contexts list. */

is(parallel_makelist(integrate(x^i, x), i, 1, 8)
   = makelist(integrate(x^i, x), i, 1, 8));
true$

/* A parallel region must leave the context list exactly as it found it:
   a scratch context surviving is what the lost update looked like from
   the outside. */

(c0: contexts,
 parallel_makelist(integrate(x^i, x), i, 1, 8),
 is(contexts = c0));
true$

/* NUMDEN leaves a numerator and a denominator in NN* and DN* for its
   caller to read, and residue() is one such caller.  Each runner needs
   its own pair: shared, residue() read another element's quotient --
   measured, 27 to 42 of these 48 elements came back wrong in every run
   on SBCL and CCL (GitHub issue #82).  Each element sums 30 residues
   minus their known values -%i/(2*k), so a right answer is 0. */

(residue_error(i) := block([e: 0],
   for j thru 30 do
     e: e + residue(1/(z^2 + (i + j)^2), z, (i + j)*%i) + %i/(2*(i + j)),
   rectform(e)),
 residue_error(1));
0$

(parallel_reset_counters(),
 [sublist(parallel_makelist(residue_error(i), i, 1, 48),
          lambda([e], e # 0)),
  if parallel_threads_available()
      then is(parallel_worker_items() > 0)
      else is(parallel_worker_items() = 0)]);
[[], true]$

/* --- assumptions ---

   An assumption made before a parallel region is in force inside it,
   and one a body makes goes into the same shared database a serial loop
   would have put it in.  Bodies must still not depend on each other's
   assumptions: nothing stops one body seeing another's, so a loop
   written that way gives an answer that depends on which core got
   there first.

   Giving each runner its own context, so that a body's facts stayed its
   own, is written and measured in src/parallel.lisp and deliberately
   not enabled: the visibility counts it relies on are global and their
   updates are not atomic, so concurrent regions unmark contexts holding
   real assumptions.  It took this very test from right every time to
   wrong 157 times in 200.  See the comment there, and issue #3. */

(assume(zz > 0),
 is(parallel_makelist(sign(zz), i, 1, 4) = makelist(sign(zz), i, 1, 4)));
true$

(forget(zz > 0), kill(all), 0);
0$

/* a body's assumptions reach the database, the same as a serial loop's */

(kill(all), makelist(assume(aa[i] > 0), i, 1, 4), length(facts()));
4$

(kill(all), parallel_makelist(assume(bb[i] > 0), i, 1, 4), length(facts()));
4$

(kill(all), 0);
0$

/* limit assumes its variable is beyond every number while it works, and
   the elements here use the same variable: one runner's assumption is
   already there when the next one asks, so that one adds none of its own
   and loses the fact when the first runner forgets it.  The scratch
   contexts must be gone afterwards, and no fact may be left behind. */

block([ref: [limit(signum(x), x, minf), limit(atan2(exp(x), x), x, minf),
             limit(unit_step(x), x, minf)],
       c0: contexts, r],
  r: parallel_makelist([limit(signum(x), x, minf),
                        limit(atan2(exp(x), x), x, minf),
                        limit(unit_step(x), x, minf)], i, 1, 16),
  [ref, is(r = makelist(ref, i, 1, 16)), is(contexts = c0), facts()]);
[[-1, %pi, 0], true, true, []]$

is(parallel_makelist(factor(i! + 1), i, 1, 10)
   = makelist(factor(i! + 1), i, 1, 10));
true$

is(parallel_makelist(expand((x + i)^5), i, 1, 10)
   = makelist(expand((x + i)^5), i, 1, 10));
true$

/* parse_string() binds the string stream it reads rather than assigning
   the global *PARSE-STRING-INPUT-STREAM*.  Assigned, a concurrent call
   could replace the stream before MREAD read it, and both calls then read
   one string in turns: measured, 420 to 689 of 9600 parallel parses came
   back as fragments of other elements' strings on CCL, such as 15*y+8,
   and up to 4 on SBCL (GitHub issue #84).  The first check needs no
   threads: a parse must leave the global value as it found it. */

(parse_string("1"),
 ps0: ?\*parse\-string\-input\-stream\*,
 parse_string("x^2 + y"),
 is(?\*parse\-string\-input\-stream\* = ps0));
true$

(parse_errors(i) := block([bad: 0],
   for j thru 200 do
     if parse_string(sconcat("x^", i, " + ", j, "*y")) # x^i + j*y
       then bad: bad + 1,
   bad),
 parse_errors(1));
0$

(parallel_reset_counters(),
 [apply("+", parallel_makelist(parse_errors(i), i, 1, 48)),
  if parallel_threads_available()
      then is(parallel_worker_items() > 0)
      else is(parallel_worker_items() = 0)]);
[0, true]$

/* --- the same answers twice: results must not depend on timing --- */

is(parallel_makelist(ratsimp((x^i - 1)/(x - 1)), i, 1, 12)
   = parallel_makelist(ratsimp((x^i - 1)/(x - 1)), i, 1, 12));
true$

/* jacobi_am's numerical AGM iteration works in arrays; each call needs
   its own, in floats and in bigfloats */

errcatch(is(parallel_makelist(jacobi_am(i/10.0, 0.5), i, 1, 200)
            = makelist(jacobi_am(i/10.0, 0.5), i, 1, 200)));
[true]$

errcatch(is(parallel_makelist(jacobi_am(bfloat(i/10), 0.5b0), i, 1, 50)
            = makelist(jacobi_am(bfloat(i/10), 0.5b0), i, 1, 50)));
[true]$

/* --- did the work really happen on another thread? ---

   The sleep is what makes this meaningful: with an instant body the
   calling thread can finish every element before a worker starts, and
   a zero count would say nothing about whether threading works. */

(parallel_reset_counters(),
 parallel_makelist(?sleep(0.02), i, 1, 16),
 if parallel_threads_available()
     then is(parallel_worker_items() > 0)
     else is(parallel_worker_items() = 0));
true$

/* factor() chooses a prime (FACT5) and later lifts modulo it (Z1), and
   passes it between the two in *PRIME, which is special only while
   factor.lisp compiles.  Each factorization must bind it: assigned, one
   runner lifted modulo another's prime, and 48 parallel factor() calls
   stopped with "CQUOTIENT: quotient is not exact" in 8 runs of 8 on SBCL
   and CCL (GitHub issue #87).  The first check needs no threads: a call
   must leave the global value as it found it. */

(prime_scratch() := if ?boundp('?\*prime) then [?symbol\-value('?\*prime)]
                     else [],
 prime_before: prime_scratch(),
 [string(factor(x^4 - y^4 + 3*(x^2 - y^2))),
  is(prime_scratch() = prime_before)]);
["-((y-x)*(y+x)*(y^2+x^2+3))", true]$

(factor_pair(i) := factor(x^4 - y^4 + i*(x^2 - y^2)),
 factor_ref: makelist(factor_pair(i), i, 1, 48),
 0);
0$

(parallel_reset_counters(),
 [is(parallel_makelist(factor_pair(i), i, 1, 48) = factor_ref),
  if parallel_threads_available()
      then is(parallel_worker_items() > 0)
      else is(parallel_worker_items() = 0)]);
[true, true]$

/* --- the cap holds, and holds across nesting ---

   Sixteen elements over four nested regions must still respect one
   session-wide limit.  Were the budget per region instead of shared,
   the inner regions would each start a full set of workers and the
   peak would reach the limit several times over. */

(parallel_reset_counters(),
 parallel_makelist(parallel_makelist(?sleep(0.01), j, 1, 4), i, 1, 4),
 is(parallel_peak_workers() < parallel_cores()));
true$

/* A nested parallel region still computes the right thing */

is(parallel_makelist(parallel_makelist(i*j, j, 1, 4), i, 1, 4)
   = makelist(makelist(i*j, j, 1, 4), i, 1, 4));
true$

/* newdet() and permanent() keep their working arrays in the specials
   *BINOM*, *MINOR1*, *INPUT* and *I*, which have no global value.  Each
   call must bind them: assigned, concurrent calls worked in each other's
   arrays -- measured, 48 parallel newdet()/permanent() pairs failed with
   Lisp errors in 5 runs of 5 on SBCL and CCL (GitHub issue #85).  The
   first check needs no threads: a call must leave the global value of
   all four as it found it -- bound to the same object, or unbound. */

(newdet_scratch() :=
   map(lambda([s], if ?boundp(s) then [?symbol\-value(s)] else []),
       ['?\*binom\*, '?\*minor1\*, '?\*input\*, '?\*i\*]),
 newdet_before: newdet_scratch(),
 [ratdisrep(newdet(matrix([1, 2, 3], [4, 5, 6], [7, 8, 10]))),
  ratdisrep(permanent(matrix([1, 2], [3, 4]))),
  is(newdet_scratch() = newdet_before)]);
[-3, 10, true]$

(newdet_ms: block([state: make_random_state(false), ms],
   set_random_state(make_random_state(11)),
   ms: makelist(genmatrix(lambda([i, j], random(19) - 9),
                          3 + mod(k, 4), 3 + mod(k, 4)), k, 1, 48),
   set_random_state(state),
   ms),
 newdet_pair(k) := [ratdisrep(newdet(newdet_ms[k])),
                    ratdisrep(permanent(newdet_ms[k]))],
 newdet_ref: makelist(newdet_pair(k), k, 1, 48),
 every(lambda([k], is(newdet_ref[k][1] = determinant(newdet_ms[k]))),
       makelist(k, k, 1, 48)));
true$

(parallel_reset_counters(),
 [is(parallel_makelist(newdet_pair(k), k, 1, 48) = newdet_ref),
  if parallel_threads_available()
      then is(parallel_worker_items() > 0)
      else is(parallel_worker_items() = 0)]);
[true, true]$

/* --- errors inside a body reach the caller --- */

errcatch(parallel_makelist(if i = 3 then 1/0 else i, i, 1, 5));
[]$

/* --- the serial fallback: same answers, and provably serial ---

   parallel_threads:1 leaves one thread for the whole session, which is
   the same path a lisp without threads takes.  This is the only way to
   exercise that path on a lisp that has them. */

(parallel_threads: 1,
 parallel_reset_counters(),
 parallel_makelist(?sleep(0.01), i, 1, 8),
 is(parallel_worker_items() = 0));
true$

(parallel_threads: 1,
 is(parallel_makelist(ratsimp((x^i - 1)/(x - 1)), i, 1, 8)
    = makelist(ratsimp((x^i - 1)/(x - 1)), i, 1, 8)));
true$

/* Setting the limit has to take effect when it is set, not once per
   session: a limit read only the first time anything ran in parallel
   would accept this and ignore it. */

(parallel_threads: 1, is(parallel_cores() = 1));
true$

/* Back to using every core before the tests below, which measure what
   the workers did and would otherwise be measuring the serial path */

(parallel_threads: 0, 0);
0$

/* The graphs package keeps each search's state in special variables:
   the depth-first search of biconnected_components() (which
   tutte_polynomial(), is_planar() and hamilton_cycle() call),
   strong_components(), max_clique() and the planarity test.  Each entry
   point must bind its state: assigned, concurrent searches shared one
   set of tables -- measured on SBCL, 5 runs of 5 failed with Lisp errors
   for biconnected_components(), strong_components(), is_planar() and
   hamilton_cycle(), max_clique() returned 62 wrong cliques of 120, and
   planar_embedding() hung (GitHub issue #75).  The first check needs no
   threads: the searches must leave the global values as they found
   them. */

(load(graphs),
 graph_scratch() :=
   map(lambda([s], if ?boundp(s) then [?symbol\-value(s)] else []),
       ['?\*dfs\-bicomp\-num\*, '?\*bicomponents\*, '?\*scon\-low\*,
        '?\*scon\-comp\*, '?\*maximum\-clique\*, '?\*facial\-walks\*,
        '?\*visited\-vertices\*, '?\*available\-faces\*]),
 graph_before: graph_scratch(),
 [biconnected_components(cycle_graph(5)),
  map(sort, strong_components(cycle_digraph(3))),
  max_clique(complete_graph(4)),
  is_planar(wheel_graph(5)),
  is(graph_scratch() = graph_before)]);
[[[0, 1, 2, 3, 4]], [[0, 1, 2]], [0, 1, 2, 3], true, true]$

(graph_items(i) := [biconnected_components(cycle_graph(mod(i, 5) + 4)),
                    strong_components(cycle_digraph(mod(i, 6) + 3)),
                    max_clique(complete_graph(mod(i, 5) + 3)),
                    is_planar(petersen_graph())],
 graph_ref: makelist(graph_items(i), i, 1, 24),
 0);
0$

(parallel_reset_counters(),
 [is(parallel_makelist(graph_items(i), i, 1, 24) = graph_ref),
  if parallel_threads_available()
      then is(parallel_worker_items() > 0)
      else is(parallel_worker_items() = 0)]);
[true, true]$

/* --- parallel(for ...) ---

   "for" is reader syntax, so it cannot be called as parallel_for(...);
   the loop is handed to parallel() unevaluated instead. */

parallel(for i: 1 thru 3 do 1);
done$

/* Every iteration runs exactly once, with the value it would have had.
   The array is a lisp one via make_array, so distinct indices really
   are distinct storage. */

(a: make_array(fixnum, 11),
 parallel(for i: 1 thru 10 do a[i]: i^2),
 listarray(a));
[0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100]$

(b: make_array(fixnum, 11),
 parallel(for i: 2 step 3 thru 10 do b[i]: i),
 listarray(b));
[0, 0, 2, 0, 0, 5, 0, 0, 8, 0, 0]$

/* Shapes whose iteration sequence is not known before the loop runs
   cannot be spread, and must still give the ordinary answer: "while"
   and "unless" decide after each body, and "next" computes each value
   from the one before. */

(c: 0, parallel(for i: 1 thru 5 while i < 4 do c: c + 1), c);
3$

(d: 0, parallel(for i: 1 next i + 2 thru 9 do d: d + 1), d);
5$

/* Wrapping something that is not a loop at all is allowed and does
   nothing, so parallel() is never the reason an expression breaks */

parallel(2 + 3);
5$

/* "return" would name one iteration's exit out of many at once */

errcatch(parallel(for i: 1 thru 4 do (if i = 2 then return(9))));
[]$

/* It really is spread across threads, same control as for makelist */

(parallel_reset_counters(),
 parallel(for i: 1 thru 16 do ?sleep(0.02)),
 if parallel_threads_available()
     then is(parallel_worker_items() > 0)
     else is(parallel_worker_items() = 0));
true$

/* tex() breaks long output lines at a column it counts as it writes.  The
   column is bound per call; one column shared by all threads moved each
   other's line breaks -- measured, 205 (SBCL) and 234 (CCL) of 240
   parallel tex() strings with frequent breaks differed from serial ones
   (GitHub issue #95). */

(tex_item(i) := block([linel: 40 + mod(i, 7)],
   tex(sum(x^k/(k + i), k, 1, 12) + matrix([i, 2], [3, i^2]), false)),
 tex_ref: makelist(tex_item(i), i, 1, 48),
 0);
0$

(parallel_reset_counters(),
 [is(parallel_makelist(tex_item(i), i, 1, 48) = tex_ref),
  if parallel_threads_available()
      then is(parallel_worker_items() > 0)
      else is(parallel_worker_items() = 0)]);
[true, true]$

/* and it draws on the same one session-wide budget */

(parallel_reset_counters(),
 parallel(for i: 1 thru 4 do parallel(for j: 1 thru 4 do ?sleep(0.01))),
 is(parallel_peak_workers() < parallel_cores()));
true$

/* md5sum(), sha1sum() and sha256sum() (stringproc) keep the hash being
   computed in special variables (*H5* and *W5*, *H1* and *W1*, *H2* and
   *W2*).  Each call must bind them: assigned, concurrent calls hashed in one
   state -- measured, 38 to 48 of 48 parallel elements came back with
   wrong digests in every run on SBCL and CCL (GitHub issue #89).  The
   first check needs no threads: the standard test vectors for "abc",
   and the global state left as it was found. */

(load(stringproc),
 hash_scratch() :=
   map(lambda([s], if ?boundp(s) then [?symbol\-value(s)] else []),
       ['?\*h5\*, '?\*w5\*, '?\*h1\*, '?\*w1\*, '?\*h2\*, '?\*w2\*]),
 hash_before: hash_scratch(),
 [md5sum("abc"), sha1sum("abc"), sha256sum("abc"),
  is(hash_scratch() = hash_before)]);
["900150983cd24fb0d6963f7d28e17f72",
 "a9993e364706816aba3e25717850c26c9cd0d89d",
 "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
 true]$

(hash_items(i) :=
   block([s: sconcat("message number ", i, " ", smake(40 + mod(i, 90), "x"))],
     [md5sum(s), sha1sum(s), sha256sum(s)]),
 hash_ref: makelist(hash_items(i), i, 1, 48),
 0);
0$

(parallel_reset_counters(),
 [is(parallel_makelist(hash_items(i), i, 1, 48) = hash_ref),
  if parallel_threads_available()
      then is(parallel_worker_items() > 0)
      else is(parallel_worker_items() = 0)]);
[true, true]$

/* --- thru_parallel and in_parallel ---

   The keyword forms, which unlike parallel() refuse a loop they cannot
   spread instead of quietly running it on one core. */

(e: make_array(fixnum, 11),
 for i: 1 thru_parallel 10 do e[i]: i^2,
 listarray(e));
[0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100]$

(f: make_array(fixnum, 11),
 for i: 2 step 3 thru_parallel 10 do f[i]: i,
 listarray(f));
[0, 0, 2, 0, 0, 5, 0, 0, 8, 0, 0]$

(g: make_array(fixnum, 4),
 for x in_parallel [7, 8, 9] do g[x - 6]: x*2,
 listarray(g));
[0, 14, 16, 18]$

for i: 1 thru_parallel 3 do 1;
done$

/* and they really do run on more than one thread */

(parallel_reset_counters(),
 for i: 1 thru_parallel 16 do ?sleep(0.02),
 if parallel_threads_available()
     then is(parallel_worker_items() > 0)
     else is(parallel_worker_items() = 0));
true$

(parallel_reset_counters(),
 for x in_parallel [1, 2, 3, 4, 5, 6, 7, 8] do ?sleep(0.02),
 if parallel_threads_available()
     then is(parallel_worker_items() > 0)
     else is(parallel_worker_items() = 0));
true$

/* nested keyword loops share the one session-wide budget */

(parallel_reset_counters(),
 for i: 1 thru_parallel 4 do (for j: 1 thru_parallel 4 do ?sleep(0.01)),
 is(parallel_peak_workers() < parallel_cores()));
true$

/* distrib's random variate generators keep the constants of their last
   parameters in special variables.  Inside a parallel element each call
   binds its own set; shared, threads drew with each other's constants --
   measured on SBCL, the means of 48 parallel elements of 100 binomial
   draws each were off by more than 5 standard errors in 35 of them,
   random_poisson() and random_beta() failed with errors, and on CCL the
   run hung (GitHub issue #93).

   Serial draws keep the shared cache and must be exactly as before. */
(load(distrib), 0);
0$

block([state: make_random_state(false), r],
  set_random_state(make_random_state(2026)),
  r: [random_poisson(4.5, 6), random_binomial(30, 0.3, 6),
      random_hypergeometric(20, 30, 15, 6), random_poisson(60, 4),
      random_binomial(200, 0.45, 4)],
  set_random_state(state),
  r);
[[2, 6, 1, 7, 1, 1], [9, 8, 13, 6, 8, 7], [7, 4, 7, 3, 8, 8],
 [59, 72, 59, 59], [95, 88, 87, 92]]$

/* Without threads: while an element is being evaluated in parallel, the
   generators leave the shared cache as they found it. */
(dist_cache() :=
   map(lambda([s], if ?boundp(s) then [?symbol\-value(s)] else []),
       ['?\*rbin\-psave\*, '?\*rpos\-muprev\*, '?\*rpos\-muold\*,
        '?\*rbeta\-olda\*, '?\*rhyp\-n1s\*, '?\*rnormal\-iset\*]),
 dist_before: dist_cache(),
 block([?\*parallel\-evaluation\-p\*: true],
   random_binomial(20, 0.35), random_poisson(7.5), random_poisson(55.5),
   random_beta(2.5, 3.5), random_hypergeometric(20, 30, 15),
   random_normal(0, 1)),
 is(dist_cache() = dist_before));
true$

/* Each element draws with its own parameters; its sample mean must be
   within 5 standard errors (a false alarm has probability about 1e-5). */
(dist_z(i) := block([n: 100, mu: 2 + 3*mod(i, 7), bn: 20 + 7*mod(i, 5),
                     bp: 0.1 + 0.1*mod(i, 8), a: 1.5 + mod(i, 6),
                     b: 2.5 + mod(i, 4), sp, sb, sa],
   sp: apply("+", random_poisson(mu, n)),
   sb: apply("+", random_binomial(bn, bp, n)),
   sa: apply("+", random_beta(a, b, n)),
   map(abs, [(sp/n - mu)/sqrt(mu/n),
             (sb/n - bn*bp)/sqrt(bn*bp*(1 - bp)/n),
             (sa/n - a/(a + b))/sqrt(a*b/((a + b)^2*(a + b + 1))/n)])),
 0);
0$

(parallel_reset_counters(),
 [is(lmax(flatten(parallel_makelist(dist_z(i), i, 1, 48))) < 5),
  if parallel_threads_available()
      then is(parallel_worker_items() > 0)
      else is(parallel_worker_items() = 0)]);
[true, true]$

/* --- do_parallel ---

   The other direction: not one expression over many values, but many
   different expressions at once. */

do_parallel([1, 2, 3]);
done$

(h: make_array(fixnum, 4),

/* Database queries must not erase another query's marks or context. */
(kill(all),0);
0$

(load(file_search("parallel-database-check.lisp",file_search_tests)),0);
0$

parallel_database_queries(false);
true$

parallel_database_contexts(false);
true$

parallel_database_numbers(false);
true$

if parallel_threads_available() then parallel_database_overlap_all() else true;
true$

parallel_database_queries(parallel_threads_available());
true$

parallel_database_contexts(parallel_threads_available());
true$

parallel_database_numbers(parallel_threads_available());
true$

parallel_makelist(integrate(x^i,x,0,1),i,0,5);
[1,1/2,1/3,1/4,1/5,1/6]$

(assume(a>0),parallel_makelist(sign(a),i,1,8));
[pos,pos,pos,pos,pos,pos,pos,pos]$

parallel_database_callback(parallel_threads_available());
true$

parallel_database_unwind(parallel_threads_available());
true$

parallel_database_edges();
true$

parallel_database_gc_edges();
true$

/* Characterize LOCAL's temporary hiding and ordinary error restoration. */
(assume(q>0),[block(local(q),facts(q)),facts(q)]);
[[],[q>0]]$

[errcatch(block(local(q),assume(q<0),error("local test"))),facts(q)];
[[],[q>0]]$

[errcatch(block(local(q,1),99)),facts(q)];
[[],[q>0]]$

(forget(q>0),0);
0$

(forget(a>0),kill(all),0);
0$

/* A kind search from a symbol with no kind fact -- nearly every one the
   simplifier makes -- answers while another thread holds the database
   lock.  Waiting for it serialized parallel simplification: 66% of all
   thread time in a parallel factor() went to that lock, from KINDP. */
parallel_database_kind_unlocked();
true$

/* The searches still answer from kind facts, and from the kinds those
   imply, exactly as before. */
(declare(kq, even), declare(kc, complex),
 [featurep(kq, integer), featurep(kq, odd),
  ?decl\-complex\-kind('kc), ?decl\-complex\-kind('kq)]);
[true, false, complex, false]$

(remove(kq, even), remove(kc, complex), 0);
0$

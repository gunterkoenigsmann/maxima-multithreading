/* Share packages written in Maxima keep state in Maxima variables.  A
   variable a function assigns without making it a block local is one
   global value cell shared by every thread (GitHub issue #66).

   nusum (share/algebra/nusum.mac) declares %r and %cf as global
   variables and used to assign them from nusuml.  Concurrent calls mixed
   each other's term ratio and coefficients: measured on SBCL, 48
   parallel calls of nusum(k^2 + i, k, 1, n) differed from serial in 4
   runs of 4, e.g. a rational function carrying a free parameter %r50 for
   a polynomial sum. */
(kill(all), 0);
0$

/* Load the package serially first: loading in a parallel body is
   refused on purpose. */
(nusum(k, k, 1, n), 0);
0$

/* No thread needed: a call leaves the global %r and %cf alone. */
(%r: 17, %cf: 19, s: nusum(k^2 + 1, k, 1, n), [s, %r, %cf]);
[(n*(2*n^2 + 3*n + 7))/6, 17, 19]$

(kill(%r, %cf, s), 0);
0$

/* Serial answers, checked independently by summing directly. */
(f(i) := nusum(k^2 + i, k, 1, n),
 sublist(makelist(i, i, 1, 12),
         lambda([i], not every(lambda([m], is(subst(n = m, f(i))
                                              = sum(k^2 + i, k, 1, m))),
                               makelist(m, m, 0, 8)))));
[]$

/* In parallel, against serial, and each result against direct sums */
(parallel_reset_counters(),
 r: parallel_makelist((?sleep(0.002), f(i)), i, 1, 48),
 is(r = makelist(f(i), i, 1, 48)));
true$

(if parallel_threads_available()
     then is(parallel_worker_items() > 0)
     else is(parallel_worker_items() = 0));
true$

sublist(makelist(i, i, 1, 48),
        lambda([i], is(subst(n = 7, r[i]) # sum(k^2 + i, k, 1, 7))));
[]$

(kill(all), 0);
0$

/* PIECE is the part the last part() or inpart() call selected, and code
   reads it right after that call: trgsmp.mac does get(piece, ...) after
   inpart(alt, 0), and so do a dozen other share packages.  It is bound
   per thread.  Shared, another runner's part() landed in between:
   measured, 48 parallel trigsimp() calls failed in 4 runs of 4 with
   "get: argument must be a symbol or a string; found: 2". */
(kill(all), 0);
0$

/* Each item selects its own part, gives the others time to run, and
   must still find its own part in PIECE. */
(parallel_reset_counters(),
 is(parallel_makelist((inpart(g(i, 2*i), 1), ?sleep(0.002), piece), i, 1, 48)
    = makelist(i, i, 1, 48)));
true$

(if parallel_threads_available()
     then is(parallel_worker_items() > 0)
     else is(parallel_worker_items() = 0));
true$

(trigsimp(sin(x)^2 + cos(x)^2), 0);
0$

(f(i) := trigsimp(sin(x)^2 + cos(x)^2 + sin(i*x)),
 is(parallel_makelist((?sleep(0.002), f(i)), i, 1, 48)
    = makelist(f(i), i, 1, 48)));
true$

makelist(f(i), i, 1, 3);
[sin(x) + 1, sin(2*x) + 1, sin(3*x) + 1]$

(kill(all), 0);
0$
